<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>OffsetRecovery.Standalone</AssemblyName>
    <RootNamespace>OffsetRecovery.Standalone</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- The only external dependency: a fast, accurate x86/x64 decoder. -->
    <PackageReference Include="Iced" Version="1.21.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The test project lives under tests/; keep its sources out of this build. -->
    <Compile Remove="tests/**/*.cs" />
  </ItemGroup>

</Project>
